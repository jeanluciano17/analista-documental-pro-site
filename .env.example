# PostgreSQL with pgvector
DATABASE_URL=postgresql://analista:CHANGE_ME@localhost:5432/analista
EMBEDDING_DIMENSIONS=1536

# Embeddings transmit extracted text to the configured provider.
# Keep false unless your organization has approved this data flow.
ALLOW_EXTERNAL_EMBEDDINGS=false
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=


# Chat model (local by default, e.g. Ollama OpenAI-compatible endpoint)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=local-model
LLM_API_KEY=
# Remote endpoints require HTTPS and explicit approval:
ALLOW_EXTERNAL_LLM=false


# Multi-tenant MCP authentication. JSON mapping: secret token -> organization id.
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep this value in a secret manager; never commit real tokens.
ANALISTA_API_TOKENS={"REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARS":"org_demo"}

# Para a ferramenta MCP analyze_process_with_ai:
DATABASE_URL=postgresql://analista:CHANGE_ME@localhost:5432/analista
ALLOW_EXTERNAL_EMBEDDINGS=false
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=local-model
LLM_API_KEY=
ALLOW_EXTERNAL_LLM=false

# API identity hardening. Rate limit is process-local; use Redis/API gateway for multi-worker production.
ANALISTA_LOGIN_RATE_LIMIT=5
ANALISTA_LOGIN_RATE_WINDOW=60
# Comma-separated exact origins. Empty means CORS is disabled.
ANALISTA_CORS_ORIGINS=

# Optional shared rate limiter. If configured, Redis must be reachable at startup.
# Use a private Redis endpoint with authentication/TLS in production.
ANALISTA_REDIS_URL=
ANALISTA_LOGIN_RATE_LIMIT=5
ANALISTA_LOGIN_RATE_WINDOW=60

# Private local storage for uploaded process documents. Mount a persistent volume in production.
ANALISTA_DOCUMENT_STORAGE=./data/documents
